{
  "name": "otondev",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Dev — governed autonomous software-engineering platform",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "check:ownership": "node scripts/check-path-ownership.mjs",
    "emit:schemas": "pnpm --filter @otondev/contracts run emit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run lint:boundaries && pnpm run check:ownership && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@otondev/sdk": "workspace:*",
    "@otondev/testkit": "workspace:*",
    "@types/node": "22.19.5",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
