{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.otondev.dev/agentdev.error.v2.json",
  "title": "agentdev.error.v2",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agentdev.error.v2"
    },
    "code": {
      "type": "string",
      "enum": [
        "ENVELOPE_INVALID",
        "SCHEMA_UNKNOWN",
        "SCHEMA_MAJOR_UNSUPPORTED",
        "SCHEMA_VALIDATION_FAILED",
        "PAYLOAD_TOO_LARGE",
        "SIGNATURE_INVALID",
        "REPLAY_DETECTED",
        "DUPLICATE_EVENT",
        "SOURCE_VERSION_STALE",
        "STATE_VERSION_CONFLICT",
        "INVALID_STATE_TRANSITION",
        "LEASE_FENCED",
        "LEASE_EXPIRED",
        "WORKFLOW_TERMINAL",
        "POLICY_DENIED",
        "POLICY_INPUT_UNKNOWN",
        "APPROVAL_REQUIRED",
        "APPROVAL_EXPIRED",
        "APPROVAL_CONSUMED",
        "APPROVAL_BINDING_MISMATCH",
        "CAPABILITY_INVALID",
        "CAPABILITY_EXPIRED",
        "CAPABILITY_REVOKED",
        "CAPABILITY_EXHAUSTED",
        "CAPABILITY_PARAMETER_MISMATCH",
        "DATA_PROVIDER_FORBIDDEN",
        "STRUCTURED_OUTPUT_INVALID",
        "BUDGET_EXHAUSTED",
        "PROVIDER_UNAVAILABLE",
        "CONTEXT_TOO_LARGE",
        "ACTION_OUTCOME_UNKNOWN",
        "IDEMPOTENCY_CONFLICT",
        "RATE_LIMITED",
        "COMPENSATION_UNAVAILABLE",
        "EVIDENCE_INCOMPLETE",
        "EVIDENCE_IMMUTABLE",
        "WORKSPACE_QUOTA_EXCEEDED",
        "WORKSPACE_QUARANTINED",
        "TOOL_NOT_PERMITTED",
        "BASE_SHA_CHANGED",
        "VERIFY_FAILED",
        "VERIFY_MANIFEST_INVALID",
        "MEMORY_PROVENANCE_MISSING",
        "MEMORY_QUARANTINED",
        "PRESENCE_CONSENT_REQUIRED",
        "PRESENCE_UNGROUNDED_RESPONSE",
        "EMERGENCY_STOP_ACTIVE",
        "OPERATOR_PAUSED",
        "TENANT_ISOLATION_VIOLATION",
        "TIMEOUT",
        "INTERNAL"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "public_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "diagnostic_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "component": {
      "type": "string",
      "enum": [
        "ingress",
        "workflow",
        "core",
        "policy",
        "broker",
        "cognition",
        "connectors",
        "audit",
        "evidence",
        "workspace",
        "executor",
        "verifier",
        "memory",
        "presence",
        "companion",
        "supervisor",
        "operator",
        "eval",
        "integration",
        "contracts",
        "sdk"
      ]
    },
    "recommended_transition": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "RECEIVED",
            "TRIAGED",
            "PLANNED",
            "WAITING_AUTH",
            "LEASED",
            "EXECUTING",
            "VERIFYING",
            "DELIVERING",
            "RECOVERING",
            "WAITING_INPUT",
            "PAUSED",
            "BLOCKED",
            "DONE",
            "REJECTED",
            "DENIED",
            "CANCELLED",
            "FAILED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "code",
    "retryable",
    "public_message",
    "diagnostic_ref",
    "component",
    "recommended_transition",
    "occurred_at"
  ]
}
