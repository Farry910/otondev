{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.otondev.dev/agentdev.plan.v2.json",
  "title": "agentdev.plan.v2",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agentdev.plan.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "service",
        "instance",
        "version"
      ]
    },
    "data_classes": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "internal_source",
          "customer",
          "confidential",
          "restricted",
          "secret"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "alg",
        "digest"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "goal_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assumptions": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "unknowns": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "expected_files": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "expected_external_effects": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "worker.command",
          "worker.file_write",
          "git.create_branch",
          "git.commit",
          "git.push",
          "git.open_draft_pr",
          "git.open_pr",
          "jira.comment",
          "jira.transition",
          "slack.post",
          "staging.deploy",
          "cognition.generate",
          "memory.write",
          "presence.speak"
        ]
      }
    },
    "steps": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "maxLength": 16,
            "pattern": "^s[0-9]+$"
          },
          "purpose": {
            "type": "string",
            "maxLength": 200
          },
          "action_class": {
            "type": "string",
            "enum": [
              "worker.command",
              "worker.file_write",
              "git.create_branch",
              "git.commit",
              "git.push",
              "git.open_draft_pr",
              "git.open_pr",
              "jira.comment",
              "jira.transition",
              "slack.post",
              "staging.deploy",
              "cognition.generate",
              "memory.write",
              "presence.speak"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "prohibited"
            ]
          },
          "success_condition": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "step_id",
          "purpose",
          "action_class",
          "risk",
          "success_condition"
        ]
      }
    },
    "definition_of_done_ref": {
      "type": "string",
      "pattern": "^dod_[a-z0-9][a-z0-9_]{0,120}$"
    },
    "rollback_or_compensation": {
      "type": "object",
      "properties": {
        "before_publish": {
          "type": "string",
          "maxLength": 200
        },
        "after_publish": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "before_publish",
        "after_publish"
      ]
    },
    "limits": {
      "type": "object",
      "properties": {
        "files_changed": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "commands": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "wall_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "files_changed",
        "commands",
        "wall_seconds"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "tenant_id",
    "workflow_id",
    "correlation_id",
    "created_at",
    "producer",
    "data_classes",
    "integrity",
    "goal_digest",
    "assumptions",
    "unknowns",
    "expected_files",
    "expected_external_effects",
    "steps",
    "definition_of_done_ref",
    "rollback_or_compensation",
    "limits"
  ]
}
