{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.otondev.dev/agentdev.action.v2.json",
  "title": "agentdev.action.v2",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agentdev.action.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^act_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "service",
        "instance",
        "version"
      ]
    },
    "data_classes": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "internal_source",
          "customer",
          "confidential",
          "restricted",
          "secret"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "alg",
        "digest"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "adapter": {
      "type": "string",
      "enum": [
        "github",
        "jira",
        "slack",
        "ci",
        "deploy"
      ]
    },
    "operation": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "action_class": {
      "type": "string",
      "enum": [
        "worker.command",
        "worker.file_write",
        "git.create_branch",
        "git.commit",
        "git.push",
        "git.open_draft_pr",
        "git.open_pr",
        "jira.comment",
        "jira.transition",
        "slack.post",
        "staging.deploy",
        "cognition.generate",
        "memory.write",
        "presence.speak"
      ]
    },
    "resource": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$"
    },
    "parameter_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "state": {
      "type": "string",
      "enum": [
        "prepared",
        "sent",
        "succeeded",
        "failed",
        "outcome_unknown"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy_decision_id": {
      "type": "string",
      "pattern": "^pdec_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "remote_ref": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ENVELOPE_INVALID",
            "SCHEMA_UNKNOWN",
            "SCHEMA_MAJOR_UNSUPPORTED",
            "SCHEMA_VALIDATION_FAILED",
            "PAYLOAD_TOO_LARGE",
            "SIGNATURE_INVALID",
            "REPLAY_DETECTED",
            "DUPLICATE_EVENT",
            "SOURCE_VERSION_STALE",
            "STATE_VERSION_CONFLICT",
            "INVALID_STATE_TRANSITION",
            "LEASE_FENCED",
            "LEASE_EXPIRED",
            "WORKFLOW_TERMINAL",
            "POLICY_DENIED",
            "POLICY_INPUT_UNKNOWN",
            "APPROVAL_REQUIRED",
            "APPROVAL_EXPIRED",
            "APPROVAL_CONSUMED",
            "APPROVAL_BINDING_MISMATCH",
            "CAPABILITY_INVALID",
            "CAPABILITY_EXPIRED",
            "CAPABILITY_REVOKED",
            "CAPABILITY_EXHAUSTED",
            "CAPABILITY_PARAMETER_MISMATCH",
            "DATA_PROVIDER_FORBIDDEN",
            "STRUCTURED_OUTPUT_INVALID",
            "BUDGET_EXHAUSTED",
            "PROVIDER_UNAVAILABLE",
            "CONTEXT_TOO_LARGE",
            "ACTION_OUTCOME_UNKNOWN",
            "IDEMPOTENCY_CONFLICT",
            "RATE_LIMITED",
            "COMPENSATION_UNAVAILABLE",
            "EVIDENCE_INCOMPLETE",
            "EVIDENCE_IMMUTABLE",
            "WORKSPACE_QUOTA_EXCEEDED",
            "WORKSPACE_QUARANTINED",
            "TOOL_NOT_PERMITTED",
            "BASE_SHA_CHANGED",
            "VERIFY_FAILED",
            "VERIFY_MANIFEST_INVALID",
            "MEMORY_PROVENANCE_MISSING",
            "MEMORY_QUARANTINED",
            "PRESENCE_CONSENT_REQUIRED",
            "PRESENCE_UNGROUNDED_RESPONSE",
            "EMERGENCY_STOP_ACTIVE",
            "OPERATOR_PAUSED",
            "TENANT_ISOLATION_VIOLATION",
            "TIMEOUT",
            "INTERNAL"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "id",
    "tenant_id",
    "workflow_id",
    "correlation_id",
    "created_at",
    "producer",
    "data_classes",
    "integrity",
    "adapter",
    "operation",
    "action_class",
    "resource",
    "parameter_digest",
    "idempotency_key",
    "state",
    "attempts",
    "policy_decision_id",
    "approval_id",
    "capability_id",
    "remote_ref",
    "last_error",
    "updated_at"
  ]
}
