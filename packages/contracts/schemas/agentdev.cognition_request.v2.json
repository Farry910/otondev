{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.otondev.dev/agentdev.cognition_request.v2.json",
  "title": "agentdev.cognition_request.v2",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agentdev.cognition_request.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^crq_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "service",
        "instance",
        "version"
      ]
    },
    "data_classes": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "internal_source",
          "customer",
          "confidential",
          "restricted",
          "secret"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "alg",
        "digest"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "plan",
        "code",
        "debug",
        "summarize",
        "classify",
        "voice",
        "reflect"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "prohibited"
      ]
    },
    "untrusted_sources": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "required_capabilities": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "quality_tier": {
      "type": "string",
      "enum": [
        "economy",
        "standard",
        "high"
      ]
    },
    "latency_budget_ms": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "cost_budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "context_refs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ctx_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "response_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider_constraints": {
      "type": "object",
      "properties": {
        "regions": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,8}$"
          }
        },
        "retention": {
          "type": "string",
          "enum": [
            "disabled",
            "zero_day",
            "provider_default"
          ]
        },
        "allowed_providers": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "required": [
        "regions",
        "retention"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "tenant_id",
    "agent_id",
    "workflow_id",
    "correlation_id",
    "created_at",
    "producer",
    "data_classes",
    "integrity",
    "purpose",
    "risk",
    "untrusted_sources",
    "required_capabilities",
    "quality_tier",
    "latency_budget_ms",
    "cost_budget_usd",
    "context_refs",
    "response_schema",
    "provider_constraints"
  ]
}
