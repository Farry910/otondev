{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.otondev.dev/agentdev.evidence.v2.json",
  "title": "agentdev.evidence.v2",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agentdev.evidence.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^evb_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "service",
        "instance",
        "version"
      ]
    },
    "data_classes": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "internal_source",
          "customer",
          "confidential",
          "restricted",
          "secret"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "alg",
        "digest"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "task_source": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$"
        }
      ]
    },
    "repository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 512
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "diff_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "url",
        "base_sha",
        "head_sha",
        "diff_digest"
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "worker_image": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
        },
        "toolchain": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "required": [
        "worker_image",
        "toolchain"
      ]
    },
    "checks": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "command_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skipped",
              "unavailable"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "log_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "log_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "command_digest",
          "status",
          "exit_code",
          "log_ref",
          "log_digest",
          "reason"
        ]
      }
    },
    "verifier": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(@sha256:[0-9a-f]{64})?$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "limitations": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "required": [
        "version",
        "verdict",
        "limitations"
      ]
    },
    "policy_refs": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pdec_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "approval_refs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "action_refs": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^act_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "artifacts": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "junit",
              "coverage",
              "diff",
              "log",
              "screenshot",
              "sbom",
              "scan",
              "other"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "retention": {
            "type": "object",
            "properties": {
              "expires_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "legal_hold": {
                "type": "boolean"
              }
            },
            "required": [
              "expires_at",
              "legal_hold"
            ]
          }
        },
        "required": [
          "ref",
          "kind",
          "digest",
          "retention"
        ]
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^evb_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "ed25519",
            "ecdsa-p256"
          ]
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "alg",
        "key_id",
        "value"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "tenant_id",
    "workflow_id",
    "correlation_id",
    "created_at",
    "producer",
    "data_classes",
    "integrity",
    "task_source",
    "repository",
    "environment",
    "checks",
    "verifier",
    "policy_refs",
    "approval_refs",
    "action_refs",
    "artifacts",
    "supersedes",
    "signature"
  ]
}
