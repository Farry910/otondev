{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.otondev.dev/agentdev.audit.v2.json",
  "title": "agentdev.audit.v2",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "agentdev.audit.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "service",
        "instance",
        "version"
      ]
    },
    "data_classes": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "internal_source",
          "customer",
          "confidential",
          "restricted",
          "secret"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "alg",
        "digest"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "trace_id",
        "span_id"
      ]
    },
    "partition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prev_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "notice",
        "security",
        "emergency"
      ]
    },
    "component": {
      "type": "string",
      "enum": [
        "ingress",
        "workflow",
        "core",
        "policy",
        "broker",
        "cognition",
        "connectors",
        "audit",
        "evidence",
        "workspace",
        "executor",
        "verifier",
        "memory",
        "presence",
        "companion",
        "supervisor",
        "operator",
        "eval",
        "integration",
        "contracts",
        "sdk"
      ]
    },
    "event": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "subject_refs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z]+_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          {
            "type": "string",
            "minLength": 3,
            "maxLength": 512,
            "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$"
          }
        ]
      }
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "message": {
      "type": "string",
      "maxLength": 512
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "id",
    "tenant_id",
    "correlation_id",
    "created_at",
    "producer",
    "data_classes",
    "integrity",
    "partition",
    "sequence",
    "prev_digest",
    "severity",
    "component",
    "event",
    "subject_refs",
    "attributes",
    "message",
    "occurred_at"
  ]
}
