<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Otondev.Spike.Companion</AssemblyName>
    <RootNamespace>Otondev.Spike.Companion</RootNamespace>
    <!-- Pulls in UIAutomationClient/UIAutomationTypes, which is how the companion inspects the
         target application's real state rather than trusting its own input calls. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Otondev.Spike.Common\Otondev.Spike.Common.csproj" />
  </ItemGroup>
</Project>
