<Project>
  <!--
    Spike code. Throwaway by design (SP1 card: "the deliverable is the finding, not the
    implementation"), but it is throwaway code whose *measurements* have to be trustworthy,
    so warnings are errors and nullable is on. A spike that produces a wrong number is worse
    than a spike that produces none.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
